# UpDown Digital — copie para /opt/updown-digital/.env e ajuste.
# NUNCA envie o .env para o GitHub. Permissão recomendada: chmod 640, dono root:updown-digital

UDS_ENVIRONMENT=production

# Gere com: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
UDS_SECRET_KEY=

# Banco exclusivo do UpDown Digital (não usar bancos de outros sistemas).
# Confirme a porta do cluster escolhido (5432 ou 5433) com: pg_lsclusters
UDS_DATABASE_URL=postgresql+psycopg://updown_digital:TROQUE_A_SENHA@127.0.0.1:5432/updown_digital

# Mídias ficam fora do código, para que atualizações não as removam
UDS_STORAGE_DIR=/opt/updown-digital/storage
UDS_FRONTEND_DIR=/opt/updown-digital/app/frontend

# Sessão administrativa (minutos). Cookies "Secure" são ativados automaticamente em produção.
UDS_ACCESS_TOKEN_MINUTES=720

# Proteção contra força bruta no login
UDS_LOGIN_MAX_ATTEMPTS=5
UDS_LOGIN_LOCKOUT_SECONDS=300

# TVs
UDS_HEARTBEAT_INTERVAL_SECONDS=30
UDS_OFFLINE_AFTER_SECONDS=90
UDS_ACTIVATION_CODE_TTL_SECONDS=900
UDS_DEVICE_TOKEN_DAYS=90
UDS_HEARTBEAT_HISTORY_KEEP_DAYS=30

# Limites de upload (MB). Ajuste também o request_body do Caddy.
UDS_MAX_IMAGE_MB=25
UDS_MAX_VIDEO_MB=1024

# Documentação da API (/docs). Em produção fica desabilitada salvo se definida como true.
UDS_ENABLE_DOCS=false
